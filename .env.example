# ==========================================================
# CHIC KIM & MIU｜靚秀國際有限公司 環境變數範例
# ----------------------------------------------------------
# 複製本檔為 .env 後填入實際值。.env 絕對不要 commit。
# ==========================================================

# ========== Payload CMS ==========
# 至少 32 字元的隨機字串。可用 `openssl rand -base64 48` 生成
PAYLOAD_SECRET=REPLACE_ME_WITH_RANDOM_STRING

# 資料庫連線。Prod 實際使用 SQLite（見 memory: prod_hetzner_deployment）
# SQLite：file:./data/chickimmiu.db
# Postgres：postgres://user:password@127.0.0.1:5432/dbname
#   （payload.config.ts 依 scheme 自動判斷走哪個 adapter，不需要額外環境變數）
DATABASE_URI=file:./data/chickimmiu.db

# DB-PG-001 遷移演練用（步驟13，Phase 1）：SQLite→PG 資料搬移腳本與一次性
# migrate CLI 指令專用，跟正式 DATABASE_URI 分開，不影響常駐行程的 DB 連線。
# 遷移正式完成、DATABASE_URI 本身切到 PG 之後這個變數就可以刪除。
DATABASE_URI_PG_REHEARSAL=

# Admin reset password（僅 src/seed/resetAdmin.ts / queryAdmin.ts 會讀取）
# 執行前 export 一次，勿寫進 .env committed
ADMIN_RESET_PASSWORD=

# /admin BasicAuth gate — 二擇一方案（另一：Cloudflare Access）
# 兩個都設才啟用，一個空就 no-op（本機 dev 預設關閉）。
# 詳見 docs/admin-cloudflare-access.md
ADMIN_BASIC_USER=
ADMIN_BASIC_PW=

# ========== 網站 ==========
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=CHIC KIM & MIU

# ========== NextAuth v5 ==========
# AUTH_URL 決定 OAuth callback 的 absolute URL。NextAuth 的 callback 慣例是
#   {AUTH_URL}/api/auth/callback/{provider}
# 例如 LINE：http://localhost:3000/api/auth/callback/line
#      prod：https://pre.chickimmiu.com/api/auth/callback/line
# 這些 URL 要在 provider 開發者後台的 Callback URL 白名單登記，否則 OAuth 會
# 在 provider 端就被擋掉（不會回到我們的站點）。詳見 docs/LINE_LOGIN_SETUP.md
AUTH_SECRET=REPLACE_ME_WITH_32_CHAR_RANDOM_STRING
AUTH_URL=http://localhost:3000

# --- 社群登入（設對 ID+Secret 那組 provider 就會自動啟用；全空則完全關閉） ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook 登入 App（developers.facebook.com；App 要切「上線」模式一般用戶才能登入）。
# 申請步驟：docs/OAUTH_GOOGLE_APPLE_SETUP.md
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# LINE Login Channel（不是 Messaging API，也不是 LINE Pay）。
# 設定步驟：docs/LINE_LOGIN_SETUP.md
AUTH_LINE_CHANNEL_ID=
AUTH_LINE_CHANNEL_SECRET=

# Apple「Sign in with Apple」— AUTH_APPLE_ID 是 Services ID（如 com.chickimmiu.web），
# AUTH_APPLE_SECRET 是用 .p8 金鑰簽出的 ES256 JWT，**最長 180 天會過期**，
# 用 scripts/generate-apple-client-secret.mjs 產生；prod 一鍵設定（含自動續簽 cron）
# 走 scripts/setup-social-oauth-prod.sh。申請步驟：docs/OAUTH_GOOGLE_APPLE_SETUP.md
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# ========== 金流 ==========
# PayPal — 在 https://developer.paypal.com 建立 App 取得
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# 綠界科技 ECPay（AIO 全方位金流 — §4 線上刷卡）
# sandbox 且三值留空時自動用綠界公開測試商店 2000132，可直接測整條刷卡流程。
# ECPAY_ENV=production 時三值必填，缺值 create API 回 503（不會用測試商店收真錢）。
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_ENV=sandbox
# AioCheckOut ChoosePayment；預設 Credit（同步刷卡）。ATM/CVS 取號是非同步，
# 會被未付款自動取消誤殺，調整取消時窗前勿開 ALL。
ECPAY_CHOOSE_PAYMENT=

# 綠界物流（電子地圖選店 — 結帳頁超商取貨）。物流模組與金流是不同組憑證，
# 需在綠界後台開通物流模組後抄三值。sandbox 且三值留空時自動用物流文件
# 公開測試商店（C2C 2000933）。ECPAY_LOGISTICS_ENV 未設時沿用 ECPAY_ENV。
ECPAY_LOGISTICS_MERCHANT_ID=
ECPAY_LOGISTICS_HASH_KEY=
ECPAY_LOGISTICS_HASH_IV=
ECPAY_LOGISTICS_ENV=
# C2C（店到店，預設）或 B2C（大宗寄倉，需另簽約；B2C 不支援 OK mart）
ECPAY_LOGISTICS_CVS_TYPE=

# 綠界電子發票（ecpayInvoiceEngine — B2CInvoice JSON+AES，paid 時自動開立）
# ECPAY_INVOICE_ENV=sandbox 且三值留空時自動用綠界官方發票測試環境（2000132）。
# ECPAY_INVOICE_ENV=production 時三值必填，缺值一律略過開立（不打 API、不堆 failed 紀錄）。
# 發票憑證與金流 ECPAY_* 是不同組，要從綠界廠商後台電子發票介接設定另抄。
ECPAY_INVOICE_MERCHANT_ID=
ECPAY_INVOICE_HASH_KEY=
ECPAY_INVOICE_HASH_IV=
ECPAY_INVOICE_ENV=sandbox

# 藍新支付 NewebPay
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=

# LINE Pay
LINE_PAY_CHANNEL_ID=
LINE_PAY_CHANNEL_SECRET=
LINE_PAY_ENV=sandbox

# ========== 客服 (會在階段 4 啟用) ==========
# LINE Official Account
NEXT_PUBLIC_LINE_OA_ID=
# Meta Messenger Plugin
NEXT_PUBLIC_FB_PAGE_ID=

# ========== 廣告追蹤 (會在階段 6 啟用) ==========
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Kim Lafayette standalone blog integrations. Keep access tokens server-side.
KIM_BLOG_ALLOWED_ORIGINS=https://blog.kimlafayette.com
KIM_INSTAGRAM_USER_ID=
KIM_INSTAGRAM_ACCESS_TOKEN=
KIM_INSTAGRAM_API_BASE=https://graph.instagram.com
KIM_INSTAGRAM_GRAPH_VERSION=v25.0
# Payload 部落格儀表板使用 GA4 Data API 唯讀讀取，並精準限制此 hostname。
# Service Account JSON 可直接貼入，或先轉成單行 base64；勿提交真實金鑰。
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
GA4_KIM_BLOG_HOSTNAME=blog.kimlafayette.com
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ========== Email（Resend） ==========
# Payload forgot-password / email 驗證信 / 日後訂單通知都走這個 adapter。
# 1. https://resend.com/onboarding 建 API key（Project → API Keys）
# 2. Domains → Add Domain → DNS 設 SPF/DKIM 驗證寄件 domain
# 3. EMAIL_FROM_ADDRESS 必須屬於已驗證 domain
# 沒設 RESEND_API_KEY 時，系統會 fallback 成把信內容 log 到 server console
# （dev 方便測試；prod 應設實際 key）。
# Prod 更新後記得 `pnpm build` + `pm2 restart`，env 會被 bake 進 bundle。
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@chickimmiu.com
KIM_BLOG_TAKEDOWN_EMAIL=service@chickimmiu.com

# ========== 雲端儲存（Cloudflare R2） ==========
# Media collection 主要儲存。四個必填 env 全有值時 Payload 自動接管：
#   - admin 上傳 → 寫到 R2 bucket
#   - 前台讀取 → /api/media/file/<filename> → plugin 改打 R2 GET
#   - sharp 產生的 thumbnail/card/tablet/desktop 也會跟著上 R2
# 任一 env 空 → fallback 到 public/media 本地磁碟（local dev 預設行為）。
#
# Cloudflare 設定步驟：
#   1. R2 → Create bucket（命名 lowercase + hyphen，例如 chickimmiu-media）
#   2. R2 → Manage R2 API Tokens → Create API token：
#      - Permissions: Object Read & Write
#      - Bucket: 上面那顆 bucket（建議 scope 縮小）
#      - 建完只顯示一次 access key + secret，馬上複製
#   3. R2_ACCOUNT_ID 在 R2 dashboard 上方那串 hex（也是 Account ID）
#   4. 公開讀取 PDP 圖：在 bucket → Settings → Public access → 啟用 r2.dev 子網域
#      或設 custom domain（推薦：media.chickimmiu.com 走 Cloudflare CDN）
#   5. R2_PUBLIC_URL 填上面拿到的公開讀取網址（用於 next.config.mjs CSP allowlist）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# 強制走本地磁碟，忽略 R2_* 設定。
#   - DISABLE_R2=1：local dev 不打 R2 配額 / 不消耗 token / hot-reload 不重複上傳
#   - 沒設或 ≠ '1'：照 R2_* 是否齊全自動切換
DISABLE_R2=

# ========== 排程 Cron（GitHub Actions 觸發） ==========
# 保護 /api/cron/* endpoints 的 Bearer token。請用 `openssl rand -base64 24` 生成。
# Prod 值需與 GitHub repo Settings → Secrets → CRON_SECRET 一致。
CRON_SECRET=REPLACE_ME_WITH_RANDOM_STRING

# ========== Google Search Console（白帽行銷 SEO 自動化） ==========
# 接通後 whitehat-marketing 的 seo/weekly cron 會匯入「高曝光低點擊」關鍵字，
# 寫進 search-console-keywords，並產出商品頁 SEO 標題 / meta / FAQ 建議。
# 缺值 = no-op（不擋其他自動化），dashboard 會顯示 gscConfigured:false。
#
# ▼ 正式用法（cron 撐得住）：Service Account
#   1. GCP Console 建 service account → 下載 JSON 金鑰 → 啟用「Search Console API」
#   2. Search Console 該網站資源 → 設定 → 使用者與權限 → 新增 SA 的 client_email（讀取即可）
#   3. 把整份 JSON 塞進這個變數（可直接貼 JSON，或先 base64 再貼，兩種都吃）
#      base64 作法：base64 -w0 sa-key.json
GSC_SERVICE_ACCOUNT_JSON=
# 網站資源 URL。URL-prefix 資源用 'https://www.chickimmiu.com/'（含結尾斜線）；
# 網域資源（Domain property）用 'sc-domain:chickimmiu.com'。留空預設前者。
GSC_SITE_URL=
# 每次抓多少 row（query×page 組合），預設 250。
GSC_ROW_LIMIT=
# ▼ 臨時測試用：靜態 access token（Google ~1 小時就過期，cron 不能靠這個）。
#   設了會優先於 Service Account；正式上線請留空。
GSC_ACCESS_TOKEN=

# ========== Kim Lafayette 跨站會員與部落格同步 ==========
# Kim 靜態站用 OAuth-style authorization code + PKCE 交換會員資料。
# 兩個 secret 都至少 32 字元，正式環境必須使用不同隨機值。
SSO_KIM_CLIENT_ID=kimlafayette-web
SSO_KIM_CLIENT_SECRET=
SSO_AUTH_CODE_SECRET=
SSO_KIM_REDIRECT_URIS=https://www.kimlafayette.com/auth/callback.php,https://blog.kimlafayette.com/auth/callback.php

# Payload 後台「預覽」按鈕與 Kim feed 的正式文章網址。
KIM_BLOG_PUBLIC_URL=https://blog.kimlafayette.com

# 選填：BlogPosts 勾選「同步到金老佛爺部落格」後觸發靜態站重建。
# URL 應為部署平台的 HTTPS build hook；token 只在 hook 需要 Bearer 驗證時設定。
KIM_BLOG_DEPLOY_HOOK_URL=
KIM_BLOG_DEPLOY_HOOK_TOKEN=

# 選填：部落格「看文章賺點數」。留空使用預設值（5 點 / 每日 3 篇 / 最低停留 20 秒）。
# 每人每篇文章終身只發一次；每日上限以台北時區計。
KIM_BLOG_READ_POINTS=
KIM_BLOG_READ_DAILY_LIMIT=
KIM_BLOG_READ_MIN_DWELL_SECONDS=
